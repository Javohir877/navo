; Remove the per-user "Open with" registration that Navo writes on first launch.
!macro customUnInstall
  DeleteRegKey HKCU "Software\Classes\Navo.Audio"
  DeleteRegKey HKCU "Software\Classes\Applications\Navo.exe"
  DeleteRegKey HKCU "Software\Navo"
  DeleteRegValue HKCU "Software\RegisteredApplications" "Navo"
  !insertmacro removeNavoExt "mp3"
  !insertmacro removeNavoExt "flac"
  !insertmacro removeNavoExt "wav"
  !insertmacro removeNavoExt "ogg"
  !insertmacro removeNavoExt "oga"
  !insertmacro removeNavoExt "opus"
  !insertmacro removeNavoExt "m4a"
  !insertmacro removeNavoExt "aac"
  !insertmacro removeNavoExt "weba"
  !insertmacro removeNavoExt "wma"
  !insertmacro removeNavoExt "ape"
  !insertmacro removeNavoExt "wv"
  !insertmacro removeNavoExt "aiff"
  !insertmacro removeNavoExt "aif"
  !insertmacro removeNavoExt "aifc"
  !insertmacro removeNavoExt "amr"
  !insertmacro removeNavoExt "awb"
  !insertmacro removeNavoExt "mka"
  !insertmacro removeNavoExt "ac3"
  !insertmacro removeNavoExt "eac3"
  !insertmacro removeNavoExt "dts"
  !insertmacro removeNavoExt "m4b"
  !insertmacro removeNavoExt "caf"
  !insertmacro removeNavoExt "tta"
  !insertmacro removeNavoExt "mpc"
  !insertmacro removeNavoExt "au"
  !insertmacro removeNavoExt "snd"
  !insertmacro removeNavoExt "spx"
  !insertmacro removeNavoExt "mp2"
  !insertmacro removeNavoExt "mpga"
  !insertmacro removeNavoExt "dsf"
  !insertmacro removeNavoExt "dff"
  !insertmacro removeNavoExt "alac"
  ; Clear the "already registered" marker so a reinstall registers again.
  Delete "$APPDATA\Navo\assoc.json"
!macroend

!macro removeNavoExt EXT
  DeleteRegValue HKCU "Software\Classes\.${EXT}\OpenWithProgids" "Navo.Audio"
!macroend
